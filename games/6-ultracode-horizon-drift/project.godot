; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Horizon Drift"
config/description="A No Man's Sky-style space exploration game: seeded galaxy, spherical planets, seamless flight, black holes."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=0

[autoload]

Events="*res://autoload/events.gd"
Universe="*res://autoload/universe.gd"
Frame="*res://autoload/frame.gd"
Game="*res://autoload/game.gd"
Audio="*res://audio/audio_manager.gd"
DebugCLI="*res://autoload/debug_cli.gd"

[debug]

gdscript/warnings/exclude_addons=true
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
3d/default_gravity=0.0
3d/run_on_separate_thread=false

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=2048
textures/default_filters/anisotropic_filtering_level=3
environment/ssao/quality=1
shading/overrides/force_vertex_shading=false

[shader_globals]

sun_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
sun_color={
"type": "color",
"value": Color(1, 0.95, 0.85, 1)
}
sun_energy={
"type": "float",
"value": 1.0
}
sky_basis={
"type": "mat3",
"value": Basis(1, 0, 0, 0, 1, 0, 0, 0, 1)
}
night_amount={
"type": "float",
"value": 0.0
}
